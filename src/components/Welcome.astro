---
import Github from "~icons/simple-icons/github";
import Linkedin from "~icons/fa-brands/linkedin";
import Mail from "~icons/lucide/mail";

import projects from "@/data/projects.json";
import ProjectCard from "./ProjectCard.astro";
---

<div class="grid grid-cols-1 gap-7">
  <section class="intro grid gap-2 md:grid-cols-[1fr_3fr]">
    <h1 class="text-2xl">Aadhish Sriram S</h1>

    <section class="about grid gap-0.5 md:gap-1 text-">
      <p>
        Hello! My Name is Aadhish or <i>dfireBird</i> in various online spaces. I'm
        a Software Developer, who likes to create interesting things. I'm currently
        working at <a
          class="text-tertiary"
          href="http://www.ibm.com/consulting">IBM</a
        >. I have a Bachelors Degree in Computer Science & Engineering.
      </p>

      <p>
        My initial programming experience was when I thought hacking and making
        games was cool back when I was in 8<sup>th</sup> grade (chunibyo?). Since
        it started as hobby, I do create various stuff outside of my working time
        and I also contribute to <a
          class="text-tertiary"
          href="http://github.com/rust-lang/rust-analyzer">rust-analyzer</a
        > when I have the chance.
      </p>

      <p>
        In the time when I'm not programming, I play Video Games, read Manga and
        watch various TV shows, Movies and Anime. I also learning Japanese and
        trying to rekindle my old reading habit (non Manga :D).
      </p>
    </section>
  </section>

  <section class="projects grid gap-1 md:grid-cols-[1fr_3fr]">
    <h2 class="text-xl md:text-2xl">Projects</h2>
    <ul class="grid gap-2">
      {
        projects.map((project) => (
          <li>
            <ProjectCard {...project} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="links grid gap-2 md:grid-cols-[1fr_3fr]">
    <h2 class="text-xl md:text-2xl">Links</h2>
    <ul class="grid grid-cols-3 gap-4 items-center w-fit text-lg">
      <li>
        <a href="http://github.com/dfireBird" aria-label="Link to Github">
          <Github />
        </a>
      </li>
      <li>
        <a
          href="http://www.linkedin.com/in/aadhish-sriram-s/"
          aria-label="Link to LinkedIn"
        >
          <Linkedin />
        </a>
      </li>
      <li>
        <a href="mailto:aadhish@dfirebird.dev" aria-label="E-Mail Address">
          <Mail />
        </a>
      </li>
    </ul>
  </section>
</div>
